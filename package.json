{
  "name": "nest-prisma-dashboard",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build && npm --prefix dashboard run build",
    "start": "nest start",
    "prestart": "npm run test:preflight:backend",
    "start:dev": "nest start --watch",
    "prestart:dev": "npm run test:preflight:backend",
    "start:prod": "node dist/main",
    "predev": "npm run test:preflight",
    "dev": "concurrently -n api,web -c green,cyan \"nest start --watch\" \"npm --prefix dashboard run dev\"",
    "lint": "eslint src test --max-warnings=0 && npm --prefix dashboard run lint",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p dashboard/tsconfig.json --noEmit",
    "test": "npm run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:database": "cross-env TESTCONTAINERS_RYUK_DISABLED=true prisma generate --schema test/prisma/schema.postgres.prisma && vitest run --config vitest.database.config.ts",
    "test:frontend": "npm --prefix dashboard run test",
    "test:e2e:prepare": "node test/scripts/prepare-e2e-db.cjs",
    "test:e2e": "playwright test",
    "test:preflight:backend": "npm run test:unit && npm run test:integration",
    "test:preflight": "npm run lint && npm run typecheck && npm run test:unit && npm run test:frontend && npm run test:integration",
    "test:ci": "npm run lint && npm run typecheck && npm run test:unit && npm run test:frontend && npm run test:integration && npm run test:database && npm run build && npm run test:e2e",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.2.1",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@playwright/test": "^1.61.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.20.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "prisma": "^6.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
